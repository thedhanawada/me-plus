---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import { link } from '../lib/ui';

interface Props {
  /** Shown after "N.R. Dhanawada - " in the tab; omit on the home page. */
  title?: string;
  description?: string;
  /** Which nav item to show as the current page. */
  section?: 'home' | 'about' | 'notes' | 'photos' | 'tv' | 'projects';
  /** Let the main column use the full page width (photos). */
  wide?: boolean;
}

const DEFAULT_DESCRIPTION =
  'The personal website of N.R. Dhanawada. Notes, photographs, projects, and work.';

const { title, description = DEFAULT_DESCRIPTION, section, wide = false } = Astro.props;
const fullTitle = title ? `N.R. Dhanawada - ${title}` : 'N.R. Dhanawada';
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/', Astro.site).href;
const hasSidebar = Astro.slots.has('sidebar');
const shareImage = new URL('/og.png', Astro.site).href;

const NAV = [
  { name: 'home', path: '/' },
  { name: 'projects', path: '/projects' },
  { name: 'about', path: '/about' },
  { name: 'notes', path: '/notes' },
  { name: 'photos', path: '/art' },
  { name: 'tv', path: '/tv' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="N.R. Dhanawada" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="N.R. Dhanawada" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="N.R. Dhanawada, solutions architect in Sydney. dhanawada.org" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="alternate" type="application/rss+xml" title="N.R. Dhanawada - Notes" href="/rss.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-v24.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Apply the theme before first paint: a saved choice wins, otherwise follow the system. -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>

  <body class="min-h-screen bg-bg-primary text-text-primary">
    <!-- Hidden until focused: lets keyboard and screen-reader users jump past the nav -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-3 focus:py-2 focus:bg-bg-inverted focus:text-text-inverted font-mono text-sm"
    >Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="wordmark" aria-label="N.R. Dhanawada, home">N.R. Dhanawada</a>
        <nav class="site-nav" aria-label="Site">{NAV.map((item) => <a href={item.path} aria-current={item.name === section ? 'page' : undefined}>{item.name}</a>)}</nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle colour theme" aria-pressed="false"><span class="dark:hidden">Dark</span><span class="hidden dark:inline">Light</span></button>
      </header>
      <div class:list={['page-layout', { 'with-sidebar': hasSidebar, 'wide-layout': wide }]}>
        <main id="main-content" tabindex="-1"><slot /></main>
        {hasSidebar && <aside class="page-aside"><slot name="sidebar" /></aside>}
      </div>
      <footer class="site-footer">
        <div><a href="mailto:nirmal@dhanawada.org" class={link}>Email</a><a href="https://github.com/thedhanawada/me-plus" target="_blank" rel="noopener noreferrer" class={link}>Source</a><a href="/rss.xml" class={link}>RSS</a><button id="shortcuts-toggle" type="button">Keyboard shortcuts</button></div>
        <p class="footer-disclaimer">The projects and opinions on this site are my own and do not represent my employer or my family.</p>
      </footer>
    </div>

    <dialog
      id="shortcuts"
      aria-labelledby="shortcuts-title"
      class="font-mono text-sm bg-bg-primary text-text-secondary border border-border-strong p-6 max-w-sm w-[calc(100%-2rem)] backdrop:bg-black/50"
    >
      <h2 id="shortcuts-title" class="font-bold text-text-primary mb-4">Keyboard shortcuts</h2>
      <dl class="grid grid-cols-[3rem_1fr] gap-y-1">
        <dt class="text-text-primary">1–5</dt><dd>home, about, notes, photos, tv</dd>
        <dt class="text-text-primary">6</dt><dd>projects</dd>
        <dt class="text-text-primary">t</dt><dd>lights on / off</dd>
        <dt class="text-text-primary">?</dt><dd>this list</dd>
        <dt class="text-text-primary">esc</dt><dd>close it</dd>
      </dl>
      <label class="flex items-start gap-3 mt-6"><input id="shortcuts-enabled" type="checkbox" checked class="mt-1" /><span>Enable single-key shortcuts</span></label>
      <form method="dialog" class="mt-6">
        <button class={link}>close</button>
      </form>
    </dialog>

    <Analytics />
  </body>
</html>

<script>
  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');

  const savedTheme = () => {
    try { return localStorage.getItem('theme'); } catch { return null; }
  };

  const themeButton = document.getElementById('theme-toggle');
  const syncThemeButton = () => themeButton?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  syncThemeButton();

  // Clicking is the only thing that saves a preference. Until then, follow the system.
  const toggleTheme = () => {
    const dark = root.classList.toggle('dark');
    syncThemeButton();
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch { /* private mode */ }
  };

  media.addEventListener('change', (e) => {
    if (!savedTheme()) { root.classList.toggle('dark', e.matches); syncThemeButton(); }
  });

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);

  const PAGES = ['/', '/about', '/notes', '/art', '/tv', '/projects'];
  const dialog = document.getElementById('shortcuts') as HTMLDialogElement | null;

  const shortcutCheckbox = document.getElementById('shortcuts-enabled') as HTMLInputElement;
  try { shortcutCheckbox.checked = localStorage.getItem('shortcuts') !== 'off'; } catch { /* private mode */ }
  shortcutCheckbox.addEventListener('change', () => {
    try { localStorage.setItem('shortcuts', shortcutCheckbox.checked ? 'on' : 'off'); } catch { /* private mode */ }
  });
  document.getElementById('shortcuts-toggle')?.addEventListener('click', () => dialog?.showModal());

  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || !shortcutCheckbox.checked) return;
    const t = e.target as HTMLElement;
    if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement || t.isContentEditable) return;
    if (document.querySelector('dialog[open]:not(#shortcuts)')) return; // e.g. the photo viewer

    if (dialog?.open) return;
    const n = Number(e.key);
    if (n >= 1 && n <= PAGES.length) {
      if (location.pathname !== PAGES[n - 1]) location.href = PAGES[n - 1];
    } else if (e.key === 't') {
      toggleTheme();
    } else if (e.key === '?') {
      e.preventDefault();
      if (dialog && !dialog.open) dialog.showModal();
    }
  });
</script>
