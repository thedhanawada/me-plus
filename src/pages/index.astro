---
import Plain from '../layouts/Plain.astro';
import Ext from '../components/Ext.astro';
import H2 from '../components/H2.astro';
import SideH from '../components/SideH.astro';
import { link } from '../lib/ui';
import { experiences, photos, posts, WATCHLIST_MEDIA } from '../data';
const current = experiences.find((e) => /present/i.test(e.period));
const sortedPosts = [...posts].sort((a,b) => b.date.localeCompare(a.date));
const watching = WATCHLIST_MEDIA.filter((m) => m.category === 'current');
---
<Plain section="home" wide>
  <div class="home-intro"><div>
  <h1 class="home-title">N.R. Dhanawada</h1>
  <div class="home-copy">
    <p>I'm a solutions architect{current && <> at {current.company}</>} in Sydney. I design the Salesforce side of government employment programs: the CRM architecture, the data pipelines, and the Lightning components over 500 staff use all day.</p>
    <p>Mostly, I find why something is broken and fix it properly instead of patching the symptom. <a href="/about" class={link}>Work and education</a>.</p>
    <p>I'm also interested in philosophy.</p>
  </div>
  </div>
    <figure><img src="https://res.cloudinary.com/dyntcx472/image/upload/q_auto,f_auto,w_800/art002e000192_yso465" alt="Earth photographed from the Orion spacecraft window during Artemis II, April 2026" width="800" height="533" class="w-full h-auto" /><figcaption class="mt-3"><Ext href="https://www.nasa.gov/image-article/hello-world/">Earth from Orion</Ext>, Artemis II, April 2026. NASA.</figcaption></figure>
  </div>
  <div class="home-sections"><div>
  <H2>Notes</H2>
  <ul>{sortedPosts.map(post => <li class="note-row"><time datetime={post.date}>{post.date}</time><div><h3><a href={`/notes/${post.slug}`} class={link}>{post.title}</a></h3><p>{post.summary}</p></div></li>)}</ul>
  <H2>Projects</H2>
  <article class="project-row"><h3><a href="/projects/forcecalendar" class={link}>forceCalendar</a></h3><p>A calendar engine and UI library for Salesforce.</p></article>
  <article class="project-row"><h3><a href="/projects/servicecite" class={link}>ServiceCite</a></h3><p>An independent, source-cited reference for Australian employment services guidelines.</p></article>
  <p class="mt-5"><a href="/projects" class={link}>Other projects and contributions</a></p>
  </div><aside class="home-aside">
    <SideH>Photographs</SideH><p><a href="/art" class={link}>{photos.length} photographs</a>.</p>
    <SideH>Watching</SideH><ul class="space-y-1">{watching.map(m => <li>{m.title}</li>)}</ul><p><a href="/tv" class={link}>The full list</a></p>
    <SideH>Contact</SideH><p><a href="mailto:nirmal@dhanawada.org" class={link}>nirmal@dhanawada.org</a></p><p><Ext href="https://github.com/thedhanawada">GitHub</Ext></p>
  </aside></div>
</Plain>
