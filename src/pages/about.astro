---
import Plain from '../layouts/Plain.astro';
import PageHeader from '../components/PageHeader.astro';
import Ext from '../components/Ext.astro';
import H2 from '../components/H2.astro';
import SideH from '../components/SideH.astro';
import { link, monthRange } from '../lib/ui';
import { education, experiences, publications } from '../data';

const SECTIONS = [
  { id: 'work', label: 'Work' },
  { id: 'education', label: 'Education' },
  { id: 'publications', label: 'Publications' },
];
---

<Plain section="about" title="About" description="Work, education, and publications.">
  <PageHeader title="About" />
  <p>
    I work at a non-profit that delivers employment and skills programs like Workforce
    Australia, SEE and SEA across Australia. I design and build the platforms our teams
    use to run them: data warehouses, ETL pipelines, reporting, CRM, custom internal tools.
  </p>

  <H2 id="work">Work</H2>
  {experiences.map((exp) => (
    <section class="career-entry">
      <h3 class="text-text-primary">
        <span class="font-bold">{exp.title}</span>,{' '}
        {exp.companyUrl ? <Ext href={exp.companyUrl}>{exp.company}</Ext> : exp.company}
      </h3>
      <p class="text-sm text-text-muted">
        {exp.location} · {monthRange(exp.period)}{exp.award && ` · ${exp.award}`}
      </p>
      {exp.highlights.map((h) => (
        <p class="mt-3"><span class="text-text-primary">{h.title}.</span> {h.description}</p>
      ))}
    </section>
  ))}

  <H2 id="education">Education</H2>
  {education.map((edu) => (
    <section class="career-entry">
      <h3 class="text-text-primary">
        <span class="font-bold">{edu.degree}, {edu.program}</span>
        <br />
        {edu.universityUrl ? <Ext href={edu.universityUrl}>{edu.university}</Ext> : edu.university}
      </h3>
      <p class="text-sm text-text-muted">{edu.location} · {edu.period.replace(' - ', '–')}</p>
      {edu.achievements && edu.achievements.length > 0 && (
        <ul class="mt-3 list-disc pl-6 marker:text-text-muted">
          {edu.achievements.map((a) => <li>{a}</li>)}
        </ul>
      )}
      {edu.courses.length > 0 && <p class="mt-3">Courses: {edu.courses.join(', ')}.</p>}
    </section>
  ))}

  <H2 id="publications">Publications</H2>
  {publications.map((pub) => (
    <section class="career-entry">
      <h3><Ext href={pub.link}>{pub.title}</Ext></h3>
      <p class="mt-1">{pub.authors.join(', ')}.</p>
      <p class="text-sm text-text-muted">
        {pub.conference}. {pub.date}, article {pub.articleNo}, pp. {pub.pages}.
      </p>
    </section>
  ))}

  <Fragment slot="sidebar">
    <SideH>On this page</SideH>
    <ul class="aside-nav">
      {SECTIONS.map((s) => <li class="py-0.5"><a href={`#${s.id}`} class={link}>{s.label}</a></li>)}
    </ul>

    <SideH>Elsewhere</SideH>
    <ul class="aside-nav">
      <li class="py-0.5"><a href="mailto:nirmal@dhanawada.org" class={link}>nirmal@dhanawada.org</a></li>
      <li class="py-0.5"><Ext href="https://github.com/thedhanawada">github.com/thedhanawada</Ext></li>
    </ul>
  </Fragment>
</Plain>
