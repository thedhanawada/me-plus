---
import Plain from '../../layouts/Plain.astro';
import PageHeader from '../../components/PageHeader.astro';
import H2 from '../../components/H2.astro';
import Ext from '../../components/Ext.astro';
import { link } from '../../lib/ui';
import { products } from '../../data/projects';

const project = products.find((product) => product.name === 'ServiceCite')!;
---

<Plain section="projects" title={project.name} description={project.tagline}>
  <PageHeader eyebrow="02 / Independent reference" title={project.name}>
    <p>{project.tagline}</p>
  </PageHeader>

  <div class="prose-note">
    <H2>Find the source</H2>
    <p>{project.description}</p>

    <H2>Keep the context with the citation</H2>
    <p>
      ServiceCite brings together public Workforce Australia and IEA guidelines
      to search, read, and cite. Each passage includes the source version and
      effective date, alongside a link to the official publication.
    </p>

    <H2>A reference, with clear boundaries</H2>
    <p>
      This is an independent reference to public guidelines. The official
      publication remains the source: ServiceCite helps you find it and retains
      the version and date alongside the passage you are reading.
    </p>
    <p><Ext href={project.url}>Visit ServiceCite ↗</Ext></p>
  </div>

  <Fragment slot="sidebar">
    <h2 class="aside-heading">Project details</h2>
    <dl class="detail-facts">
      <div><dt>Type</dt><dd>Independent reference</dd></div>
      <div><dt>Subject</dt><dd>Australian employment services</dd></div>
      <div><dt>Source material</dt><dd>Public Workforce Australia and IEA guidelines</dd></div>
      <div><dt>Website</dt><dd><Ext href={project.url}>servicecite.org ↗</Ext></dd></div>
    </dl>
    <h2 class="aside-heading">Keep exploring</h2>
    <ul class="space-y-3">
      <li><a href="/projects/forcecalendar" class={link}>01 / forceCalendar →</a></li>
      <li><a href="/projects" class={link}>All projects</a></li>
    </ul>
  </Fragment>
</Plain>
