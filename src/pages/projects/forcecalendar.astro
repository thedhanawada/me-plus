---
import Plain from '../../layouts/Plain.astro';
import PageHeader from '../../components/PageHeader.astro';
import H2 from '../../components/H2.astro';
import Ext from '../../components/Ext.astro';
import { link } from '../../lib/ui';
import { featuredProject as project } from '../../data/projects';
---
<Plain section="projects" title={project.name} description={project.tagline}>
  <PageHeader title={project.name} />
  <p class="mb-5">A calendar engine and UI library for Salesforce, written in JavaScript with no dependencies.</p>
  <p>It handles RFC 5545 recurrence, timezones, conflict detection, search, and ICS import and export. The interface provides month, week, day, and list views as Web Components.</p>
  <H2>Packages</H2>
  <ul class="space-y-5">{project.packages.map(pkg => <li><Ext href={`https://www.npmjs.com/package/${pkg.name}`}>{pkg.name}</Ext><p class="mt-1 text-text-secondary">{pkg.summary}</p></li>)}</ul>
  <p class="mt-8"><Ext href={project.links.github}>Source on GitHub</Ext></p>
  <p class="mt-12"><a href="/projects" class={link}>← Projects</a></p>
</Plain>
