---
import PageHeader from '../components/PageHeader.astro';
import Plain from '../layouts/Plain.astro';
import Ext from '../components/Ext.astro';
import H2 from '../components/H2.astro';
import SideH from '../components/SideH.astro';
import { link } from '../lib/ui';
import { fetchWatchlist } from '../lib/tmdb';
import { WATCHLIST_MEDIA, WATCHLIST_SECTIONS } from '../data';

const media = await fetchWatchlist(WATCHLIST_MEDIA);

const sections = WATCHLIST_SECTIONS.map((section) => ({
  ...section,
  items: WATCHLIST_MEDIA.filter((m) => m.category === section.key)
    .map((m) => media.get(m.id))
    .filter((m) => m !== undefined),
})).filter((s) => s.items.length > 0);
---

<Plain section="tv" title="TV" description="What I'm watching, rewatching, and waiting for.">
  <PageHeader eyebrow="Off the clock / Watchlist" title="On screen.">What I'm watching, rewatching over dinner, and waiting on.</PageHeader>

  {sections.length === 0 ? (
    <p class="mt-12 text-text-muted">
      No titles listed yet.
    </p>
  ) : (
    sections.map((section) => (
      <section>
        <H2 id={section.key}>{section.title}</H2>
        <ul class="watch-list">
          {section.items.map((item) => (
            <li class="watch-item">
              {item.poster ? (
                <img src={item.poster} alt="" width="54" height="81" loading="lazy" class="watch-poster" />
              ) : (
                <span class="watch-poster" aria-hidden="true" />
              )}
              <span>
                <Ext href={`https://www.themoviedb.org/${item.type}/${item.id}`}>{item.title}</Ext>
                <span class="watch-meta">
                  {[item.year, item.type === 'tv' ? 'series' : 'film', item.rating ? `${item.rating.toFixed(1)}/10` : null]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}

  <Fragment slot="sidebar">
    <SideH>Sections</SideH>
    <ul class="space-y-1">
      {WATCHLIST_SECTIONS.map((s) => (
        <li class="py-0.5">
          <a href={`#${s.key}`} class={link}>{s.title}</a>{' '}
          <span class="text-text-muted">({WATCHLIST_MEDIA.filter((m) => m.category === s.key).length})</span>
        </li>
      ))}
    </ul>

    <SideH>Where this comes from</SideH>
    <p>
      The list is maintained here. <Ext href="https://www.themoviedb.org/">TMDB</Ext> supplies title details, posters, years and ratings when the site is built. If those details are unavailable, the local titles stay on the list. Ratings are TMDB community scores, not my ratings.
    </p>
  </Fragment>
</Plain>
