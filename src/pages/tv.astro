---
import PageHeader from '../components/PageHeader.astro';
import Plain from '../layouts/Plain.astro';
import Ext from '../components/Ext.astro';
import H2 from '../components/H2.astro';
import { link } from '../lib/ui';
import { fetchWatchlist } from '../lib/tmdb';
import { WATCHLIST_MEDIA, WATCHLIST_SECTIONS } from '../data';

const media = await fetchWatchlist(WATCHLIST_MEDIA);

const sections = WATCHLIST_SECTIONS.map((section) => ({
  ...section,
  items: WATCHLIST_MEDIA.filter((m) => m.category === section.key)
    .map((m) => media.get(m.id))
    .filter((m) => m !== undefined),
})).filter((s) => s.items.length > 0);
---

<Plain section="tv" title="TV" description="What I'm watching, rewatching, and waiting for.">
  <PageHeader title="TV">What I'm watching, rewatching over dinner, and waiting on.</PageHeader>

  <nav class="page-links" aria-label="Watchlist sections">{WATCHLIST_SECTIONS.map(s => <a href={`#${s.key}`} class={link}>{s.title}</a>)}</nav>

  {sections.length === 0 ? (
    <p class="mt-12 text-text-muted">
      No titles listed yet.
    </p>
  ) : (
    sections.map((section) => (
      <section>
        <H2 id={section.key}>{section.title}</H2>
        <ul class="watch-list">
          {section.items.map((item) => (
            <li class="watch-item">
              {item.poster ? (
                <img src={item.poster} alt="" width="54" height="81" loading="lazy" class="watch-poster" />
              ) : (
                <span class="watch-poster" aria-hidden="true" />
              )}
              <span>
                <Ext href={`https://www.themoviedb.org/${item.type}/${item.id}`}>{item.title}</Ext>
                <span class="watch-meta">
                  {[item.year, item.type === 'tv' ? 'series' : 'film', item.rating ? `${item.rating.toFixed(1)}/10` : null]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}

  <p class="source-note">Title details and posters from <Ext href="https://www.themoviedb.org/">TMDB</Ext>. Ratings are TMDB community scores.</p>
</Plain>
