---
import type { MarkdownInstance } from 'astro';
import Plain from '../../layouts/Plain.astro';
import { link } from '../../lib/ui';
import { posts } from '../../data';

// One page per entry in data/posts.ts; the body is src/content/posts/<slug>.md
const files = import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../../content/posts/*.md', { eager: true });

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const file = files[`../../content/posts/${post.slug}.md`];
if (!file) throw new Error(`No markdown file for post "${post.slug}"`);
const { Content } = file;
---

<Plain section="notes" title={post.title} description={post.summary}>
  <p class="text-sm mb-8"><a href="/notes" class={link}>← all notes</a></p>

  <h1 class="text-2xl font-bold text-text-primary leading-snug">{post.title}</h1>
  <p class="mt-2 text-sm text-text-muted">{post.date} · {post.tags.join(', ')}</p>

  <article class="prose-note mt-10 pt-10 border-t border-border-primary">
    <Content />
  </article>
</Plain>
