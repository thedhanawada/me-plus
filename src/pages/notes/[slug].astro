---
import type { MarkdownInstance } from 'astro';
import Plain from '../../layouts/Plain.astro';
import { link } from '../../lib/ui';
import { posts } from '../../data';

// One page per entry in data/posts.ts; the body is src/content/posts/<slug>.md
const files = import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../../content/posts/*.md', { eager: true });

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const file = files[`../../content/posts/${post.slug}.md`];
if (!file) throw new Error(`No markdown file for post "${post.slug}"`);
const { Content, getHeadings } = file;
const headings = getHeadings().filter((h) => h.depth === 2);
const other = posts.find((p) => p.slug !== post.slug);
---

<Plain section="notes" title={post.title} description={post.summary}>
  <p class="text-sm mb-8"><a href="/notes" class={link}>← all notes</a></p>

  <h1 class="article-title">{post.title}</h1><p class="article-summary">{post.summary}</p>
  <p class="article-meta"><time datetime={post.date}>{post.date}</time></p>
  <details class="article-contents"><summary>Contents</summary><nav class="aside-nav" aria-label="Article contents">{headings.map(h => <a href={`#${h.slug}`} class={link}>{h.text}</a>)}</nav></details>
  <article class="prose-note mt-10 pt-6 border-t border-border-primary"><Content /></article>
  {other && <div class="mt-12 pt-6 border-t border-border-primary"><a href={`/notes/${other.slug}`} class={link}>{other.title}</a></div>}
</Plain>
