---
import Plain from '../../layouts/Plain.astro';
import { link } from '../../lib/ui';
import { posts } from '../../data';

const sortedPosts = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---

<Plain section="notes" title="Notes" description="Thinking out loud about systems, code, and building things.">
  <h1 class="text-2xl font-bold text-text-primary mb-6">Notes</h1>
  <p>Thinking out loud about systems, code, and building things. There's an <a href="/rss.xml" class={link}>RSS feed</a>.</p>

  {sortedPosts.length === 0 ? (
    <p class="mt-12 text-text-muted">Nothing here yet.</p>
  ) : (
    <ul class="mt-12 space-y-8">
      {sortedPosts.map((post) => (
        <li>
          <p class="text-sm text-text-muted tabular-nums">{post.date}</p>
          <h2 class="mt-1"><a href={`/notes/${post.slug}`} class={link}>{post.title}</a></h2>
          <p class="mt-1">{post.summary}</p>
          <p class="mt-1 text-sm text-text-muted">tags: {post.tags.join(', ')}</p>
        </li>
      ))}
    </ul>
  )}
</Plain>
