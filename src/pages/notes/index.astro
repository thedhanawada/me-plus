---
import PageHeader from '../../components/PageHeader.astro';
import Plain from '../../layouts/Plain.astro';
import { link } from '../../lib/ui';
import { posts } from '../../data';

const sortedPosts = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---

<Plain section="notes" title="Notes" description="Thinking out loud about systems, code, and building things.">
  <PageHeader eyebrow="Notes / writing" title="Thinking in public.">About systems, code, and building things. Occasional notes, without a publishing schedule.</PageHeader>
  <p class="text-sm"><a href="/rss.xml" class={link}>Subscribe via RSS ↗</a></p>
  <ul class="mt-8">{sortedPosts.map((post) => (
    <li class="note-row"><time datetime={post.date}>{post.date}</time><div><h2><a href={`/notes/${post.slug}`}>{post.title}</a></h2><p>{post.summary}</p><div class="row-meta">{post.tags.join(' / ')}</div></div></li>
  ))}</ul>
</Plain>
