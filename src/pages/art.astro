---
import PageHeader from '../components/PageHeader.astro';
import Plain from '../layouts/Plain.astro';
import { photos, type Photo } from '../data';

const cloud = import.meta.env.VITE_CLOUDINARY_CLOUD_NAME ?? process.env.VITE_CLOUDINARY_CLOUD_NAME;
if (!cloud) console.warn('[art] VITE_CLOUDINARY_CLOUD_NAME is not set; the photos page will say so.');

const url = (p: Photo, width: number) =>
  `https://res.cloudinary.com/${cloud}/image/upload/w_${width},q_auto,f_auto/${p.id}`;

// Let the browser pick a thumbnail close to its displayed width. Capped at 600 px,
// the size every thumbnail used to be, so no screen downloads more than before.
const srcset = (p: Photo, widths: number[]) => widths.map((w) => `${url(p, w)} ${w}w`).join(', ');
// Page content is at most ~1030 px wide: favourites are 3 across, the rest 2–4 columns
const FAV_SIZES = '(min-width: 1100px) 450px, (min-width: 761px) 40vw, 100vw';
const REST_SIZES = '(min-width: 1100px) 370px, (min-width: 761px) 32vw, 48vw';

const favourites = photos.filter((p) => p.favorite);
const rest = photos.filter((p) => !p.favorite);
---

<Plain section="photos" title="Photographs" description="A collection of photographs." wide>
  <div class="gallery-head"><PageHeader title="Photographs" /><span class="gallery-count">{photos.length} photographs</span></div>
  {cloud ? <p class="text-sm text-text-muted">Click a photograph to enlarge it. Use the arrow keys or swipe to move between photographs.</p> : <p>Photographs are temporarily unavailable.</p>}

  {cloud && (
    <Fragment>
      <h2 class="section-heading">Favourites</h2>
      <div class="gallery-favourites">
        {favourites.map((p, i) => (
          <figure><button class="photo block w-full bg-bg-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring" data-full={url(p, 1600)} data-alt={p.alt} title={p.alt} aria-label={`View photo: ${p.alt}`}>
            <img src={url(p, 600)} srcset={srcset(p, [300, 600])} sizes={FAV_SIZES} alt={p.alt} width={p.width} height={p.height} fetchpriority={i === 0 ? 'high' : 'auto'} class="w-full h-auto" />
          </button><figcaption class="photo-label">{p.alt}</figcaption></figure>
        ))}
      </div>

      <h2 id="all" class="section-heading">More photographs</h2>
      <div class="gallery-rest">
        {rest.map((p) => (
          <figure><button class="photo block w-full break-inside-avoid bg-bg-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring" data-full={url(p, 1600)} data-alt={p.alt} title={p.alt} aria-label={`View photo: ${p.alt}`}>
            <img src={url(p, 600)} srcset={srcset(p, [300, 600])} sizes={REST_SIZES} alt={p.alt} width={p.width} height={p.height} loading="lazy" class="w-full h-auto" />
          </button><figcaption class="photo-label">{p.alt}</figcaption></figure>
        ))}
      </div>
    </Fragment>
  )}

  <!-- Full-screen viewer. Always black, whatever the theme. -->
  <dialog
    id="viewer"
    aria-label="Photo viewer"
    class="fixed inset-0 m-0 p-0 w-screen h-[100dvh] max-w-none max-h-none bg-black text-white/80 font-mono text-sm backdrop:bg-black"
  >
    <div class="absolute top-0 inset-x-0 flex justify-between p-4 z-10">
      <span id="viewer-count" aria-live="polite"></span>
      <button id="viewer-close" class="hover:text-white underline underline-offset-2">close (esc)</button>
    </div>
    <div id="viewer-stage" class="absolute inset-0 flex items-center justify-center pt-14 pb-24 px-2">
      <img id="viewer-img" alt="" class="max-w-[90vw] max-h-full object-contain transition-opacity duration-200" />
    </div>
    <div class="absolute bottom-0 inset-x-0 flex justify-between items-center gap-4 p-4 z-10 bg-black/80">
      <button id="viewer-prev" class="hover:text-white underline underline-offset-2 shrink-0">← prev</button>
      <span id="viewer-caption" class="text-xs text-white/70 text-center"></span>
      <button id="viewer-next" class="hover:text-white underline underline-offset-2 shrink-0">next →</button>
    </div>
  </dialog>
</Plain>

<script>
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('button.photo')];
  const viewer = document.getElementById('viewer') as HTMLDialogElement;
  const img = document.getElementById('viewer-img') as HTMLImageElement;
  const count = document.getElementById('viewer-count')!;
  const caption = document.getElementById('viewer-caption')!;
  let current = 0;
  let opener: HTMLButtonElement | undefined;

  const preload = (i: number) => {
    const t = tiles[(i + tiles.length) % tiles.length];
    if (t) new Image().src = t.dataset.full!;
  };

  const show = (i: number) => {
    current = (i + tiles.length) % tiles.length;
    const t = tiles[current];
    img.style.opacity = '0';
    img.onload = () => { img.style.opacity = '1'; };
    img.onerror = () => { img.style.opacity = '1'; caption.textContent = `This image could not load. ${t.dataset.alt ?? ''}`; };
    img.src = t.dataset.full!;
    img.alt = t.dataset.alt ?? '';
    caption.textContent = t.dataset.alt ?? '';
    count.textContent = `${current + 1} / ${tiles.length}`;
    preload(current + 1);
    preload(current - 1);
  };

  tiles.forEach((t, i) =>
    t.addEventListener('click', () => {
      opener = t;
      show(i);
      document.body.style.overflow = 'hidden';
      viewer.showModal();
    })
  );

  viewer.addEventListener('close', () => {
    document.body.style.overflow = '';
    opener?.focus();
  });

  document.getElementById('viewer-close')!.addEventListener('click', () => viewer.close());
  document.getElementById('viewer-prev')!.addEventListener('click', () => show(current - 1));
  document.getElementById('viewer-next')!.addEventListener('click', () => show(current + 1));

  // Clicking the black space around the photo closes it
  document.getElementById('viewer-stage')!.addEventListener('click', (e) => {
    if (e.target !== img) viewer.close();
  });

  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
  });

  // Swipe left/right on touch screens
  let startX = 0;
  let startY = 0;
  viewer.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
  }, { passive: true });
  viewer.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
  });
</script>
