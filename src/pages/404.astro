---
import PageHeader from '../components/PageHeader.astro';
import Plain from '../layouts/Plain.astro';
import { link } from '../lib/ui';
---

<Plain title="Not found" description="There's nothing at this address.">
  <PageHeader title="Page not found" />
  <p>
    There’s no page at <code id="missing-path" class="text-text-primary">this address</code>.
  </p>
  <p class="mt-4"><a href="/" class={link}>Home</a></p>
</Plain>

<script>
  // The page is static, so fill in the path the visitor actually asked for.
  const el = document.getElementById('missing-path');
  if (el) el.textContent = location.pathname;
</script>
